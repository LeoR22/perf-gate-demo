        "query": "https://leor22.github.io/perf-gate-demo/grafana.json",
        "current": {
          "text": "https://leor22.github.io/perf-gate-demo/grafana.json",
          "value": "https://leor22.github.io/perf-gate-demo/grafana.json"
        }
      },
      {
        "name": "version",
        "label": "Versión",
        "type": "custom",
        "query": "version-a,version-b",
        "current": {
          "text": "version-a",
          "value": "version-a"
        },
        "options": [
          {
            "text": "version-a",
            "value": "version-a",
            "selected": true
          },
          {
            "text": "version-b",
            "value": "version-b",
            "selected": false
          }
        ]
      }
    ]
