      "id": 1,
      "type": "stat",
      "title": "Veredicto",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_INFINITY}"
      },
      "gridPos": {
        "h": 4,
        "w": 9,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_INFINITY}"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "${source}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "versions",
          "columns": [
            {
              "selector": "version",
              "text": "version",
              "type": "string"
            },
            {
              "selector": "status",
              "text": "Estado",
              "type": "string"
            }
          ],
          "filterExpression": "version == '${version}'"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "version": true
            }
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Estado$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "PASS": {
                  "text": "✓ PASA",
                  "color": "green",
                  "index": 0
                },
                "WARN": {
                  "text": "! PASA CON ADVERTENCIAS",
                  "color": "orange",
                  "index": 1
                },
                "FAIL": {
                  "text": "✕ NO PASA",
                  "color": "red",
                  "index": 2
                },
                "SKIP": {
                  "text": "– OMITIDO",
                  "color": "text",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      }
